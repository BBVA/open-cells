{
  "name": "@open-cells/create-app",
  "version": "1.2.0",
  "description": "Scaffold for Open Cells apps",
  "license": "MIT",
  "type": "module",
  "author": "Julio E. Castillo Anselmi",
  "bin": {
    "create-app": "./src/create.js"
  },
  "scripts": {
    "start": "node ./src/create.js",
    "test": "vitest run",
    "release": "changeset publish"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "create-app",
    "open-cells",
    "generator",
    "scaffold",
    "create"
  ],
  "dependencies": {
    "@inquirer/prompts": "~8.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.16.0",
    "vitest": "^3.0.0"
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "always",
    "printWidth": 100,
    "trailingComma": "all"
  },
  "publishConfig": {
    "access": "public"
  }
}
